{
  "name": "obermillers",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "description": "Family hub and small tools at obermillers.com",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "bank:dev": "node scripts/bank-dev.mjs",
    "bank:setup": "node scripts/setup-pocketbase.mjs",
    "bank:setup:prod": "node --env-file=.env --env-file=.env.local scripts/setup-pocketbase.mjs",
    "bank:redirect": "./scripts/redirect-bank-subdomain.sh",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "knip": "knip",
    "check": "npm run typecheck && npm run lint && npm run fmt:check && npm run knip",
    "preview": "vite preview",
    "publish": "./publish.sh",
    "generate": "tsx scripts/generate-thumbnails.ts",
    "scanify:assets": "tsx scripts/scanify-build-assets.ts",
    "scanify:crt-check": "tsx scripts/scanify-crt-check.ts",
    "scanify:download-check": "tsx scripts/scanify-download-check.ts"
  },
  "dependencies": {
    "@imgly/background-removal": "^1.7.0",
    "@zoontek/chicane": "^3.0.0",
    "lucide-react": "^1.41.0",
    "onnxruntime-web": "^1.21.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "puppeteer": "^24.15.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "pocketbase": "^0.28.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.33.0",
    "tailwind-merge": "^3.6.0",
    "ts-pattern": "^5.9.0",
    "valibot": "^1.4.2",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^5.2.0",
    "knip": "^6.34.0",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vite-plugin-pwa": "^1.3.0"
  }
}
